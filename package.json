{
  "name": "translateall",
  "private": true,
  "version": "1.0.0",
  "description": "TranslateAll - AI Live Game, TV & Camera Translator powered by NVIDIA NIM",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env VITE_HTTPS=true vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder --win",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap open android",
    "cap:ios": "npm run build && npx cap open ios",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.translateall.pc",
    "productName": "TranslateAll",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.0.4"
  }
}
